#!/usr/bin/env bash

# Dispatch to the wp-sync-deploy scripts, e.g. when installed via composer:
# `vendor/bin/wp-sync-deploy <deploy|sync|upload|config> [args]`

PACKAGE_DIR=$(dirname "$(dirname "$(realpath "$0")")")

COMMAND="${1:-}"
[ $# -gt 0 ] && shift

case $COMMAND in
deploy | sync | upload | config)
    exec "$PACKAGE_DIR/$COMMAND.sh" "$@"
    ;;
# Alias for `config init`
setup)
    exec "$PACKAGE_DIR/config.sh" init "$@"
    ;;
*)
    echo "Usage: wp-sync-deploy <deploy|sync|upload|config> [args]"
    exit 1
    ;;
esac
