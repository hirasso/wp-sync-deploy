{
    "name": "hirasso/wp-sync-deploy",
    "description": "Sync and deploy your WordPress website between environments 🔀",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "suggest": {
        "php-stubs/wp-cli-stubs": "IDE support for wp-sync-deploy.tasks.php"
    },
    "autoload": {
        "classmap": ["src/"]
    },
    "bin": ["bin/wp-sync-deploy"],
    "scripts": {
        "release": [
            "Composer\\Config::disableProcessTimeout",
            "scripts/release.sh"
        ]
    }
}
